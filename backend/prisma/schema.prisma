generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(USER)
  phone      String?  @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor              Vendor?
  bookings            Booking[]
  reviews             Review[]
  budget              Budget[]
  timelines           Timeline[]
  checklists          Checklist[]
  notifications       Notification[]
  guests              Guest[]
  chatMessages        ChatMessage[]
  leads               Lead[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]

  warningCount   Int       @default(0)
  chatMutedUntil DateTime?
  isChatFlagged  Boolean   @default(false)

  sentMessages Message[] @relation("SentMessages")

  receivedMessages Message[] @relation("ReceivedMessages")

  customerConversations Conversation[] @relation("CustomerConversations")

  wishlists Wishlist[]
}

model Portfolio {
  id String @id @default(uuid())

  title       String
  category    String
  description String?

  imageUrl String

  vendorId      String
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id String @id @default(uuid())

  frontendVendorId Int? @unique

  businessName String

  description String?

  address String?

  city String?

  logoUrl String?

  coverImage String?

  businessVerified  Boolean @default(false)
  gstVerified       Boolean @default(false)
  bankVerified      Boolean @default(false)
  documentsUploaded Boolean @default(false)

  isActive Boolean @default(true)

  website   String?
  instagram String?
  facebook  String?
  youtube   String?
  linkedin  String?

  experience String?
  gstNumber  String?

  status VendorStatus @default(PENDING)

  rejectionReason String?

  approvedAt DateTime?

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id])

  packages Package[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  gallery VendorGallery[]

  bookings Booking[]

  availability VendorAvailability[]

  portfolio Portfolio[]

  reviews Review[]

  leads Lead[]

  conversations Conversation[]

  wishlists Wishlist[]

  @@index([categoryId])
  @@index([status])
}

model VendorGallery {
  id       String @id @default(uuid())
  imageUrl String

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model Category {
  id    String  @id @default(uuid())
  name  String  @unique
  image String?

  vendors   Vendor[]
  packages  Package[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Package {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  inclusions  String[]

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bookings  Booking[]
  reviews   Review[]
  leads     Lead[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([vendorId])
  @@index([categoryId])
}

enum BookingStatus {
  PENDING
  ACCEPTED
  CONFIRMED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  PARTIAL
  REFUNDED
}

enum AvailabilityStatus {
  BLOCKED
}

model VendorAvailability {
  id     String             @id @default(uuid())
  date   DateTime
  status AvailabilityStatus @default(BLOCKED)
  reason String?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, date])
  @@index([vendorId])
  @@index([date])
}

model Booking {
  id String @id @default(uuid())

  bookingNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // Event Details
  eventType String?
  eventDate DateTime
  eventTime String?

  venue String?
  city  String?

  guests Int @default(0)

  customerName  String?
  customerEmail String?
  customerPhone String?

  brideName String?
  groomName String?

  partnerName       String?
  partnerEmail      String?
  partnerPhone      String?
  partnerOccupation String?

  contactAddress String?
  contactState   String?
  contactCountry String?
  weddingTheme   String?

  notes               String?
  specialRequirements String?

  // Pricing
  totalAmount Decimal @db.Decimal(10, 2)

  paymentStatus PaymentStatus @default(PENDING)

  amountPaid Decimal @default(0) @db.Decimal(10, 2)

  remainingAmount Decimal @default(0) @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  @@index([userId])
  @@index([vendorId])
  @@index([packageId])
  @@index([status])
}

