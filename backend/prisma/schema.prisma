generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorBadge {
  BRONZE
  SILVER
  GOLD
}

enum VendorBadgeBillingCycle {
  MONTHLY
  YEARLY
}

enum CustomerMembership {
  FREE
  PREMIUM
}

enum AdminVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PremiumPlanningStatus {
  SUBMITTED
  UNDER_REVIEW
  VENDORS_ASSIGNED
  QUOTED
  ACCEPTED
  REJECTED
  BOOKED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  VENDOR_MANAGER
  BOOKING_MANAGER
  PREMIUM_PLANNING_MANAGER
  SUPPORT_ADMIN
  CONTENT_MANAGER
  REVIEW_DISPUTE_MANAGER
  CHAT_MODERATOR
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(USER)
  phone      String?  @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  membership               CustomerMembership @default(FREE)
  membershipActivatedAt    DateTime?
  membershipPaymentOrderId String?            @unique
  membershipPaymentId      String?

  adminVerificationStatus AdminVerificationStatus @default(PENDING)
  adminVerifiedAt         DateTime?
  adminRejectionReason    String?

  adminRole          AdminRole?
  adminPermissions   String[]   @default([])
  adminIsActive      Boolean    @default(true)
  mustChangePassword Boolean    @default(false)

  vendor              Vendor?
  bookings            Booking[]
  reviews             Review[]
  budget              Budget[]
  timelines           Timeline[]
  checklists          Checklist[]
  notifications       Notification[]
  guests              Guest[]
  chatMessages        ChatMessage[]
  leads               Lead[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]

  warningCount        Int       @default(0)
  chatMutedUntil      DateTime?
  isChatFlagged       Boolean   @default(false)
  isChatBlocked       Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  chatLastViolationAt DateTime?
  chatViolationReason String?

  sentMessages Message[] @relation("SentMessages")

  receivedMessages Message[] @relation("ReceivedMessages")

  customerConversations Conversation[] @relation("CustomerConversations")

  wishlists               Wishlist[]
  adminAuditLogs          AdminAuditLog[]
  premiumPlanningRequests PremiumPlanningRequest[]

  @@index([adminVerificationStatus])
}

model PremiumPlanningRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weddingType         String
  venuePreference     String
  budget              Decimal  @db.Decimal(12, 2)
  city                String
  guestCount          Int
  theme               String
  requiredVendors     String[]
  specialRequirements String?

  status            PremiumPlanningStatus @default(SUBMITTED)
  assignedVendorIds String[]              @default([])
  quotationAmount   Decimal?              @db.Decimal(12, 2)
  quotationDetails  Json?
  adminNotes        String?
  reviewedAt        DateTime?
  quotedAt          DateTime?
  respondedAt       DateTime?
  bookedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AdminAuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource])
  @@index([createdAt])
}

model VendorRegistrationVerification {
  id String @id @default(uuid())

  ownerName String
  email     String
  phone     String
  otpHash   String

  verifiedAt DateTime?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

model Portfolio {
  id String @id @default(uuid())

  title       String
  category    String
  categories  String[] @default([])
  description String?

  imageUrl String

  vendorId      String
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id                     String                  @id @default(uuid())
  businessName           String
  description            String?
  address                String?
  userId                 String                  @unique
  categoryId             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  coverImage             String?
  logoUrl                String?
  status                 VendorStatus            @default(PENDING)
  approvedAt             DateTime?
  rejectionReason        String?
  frontendVendorId       Int?                    @unique
  bankVerified           Boolean                 @default(false)
  businessVerified       Boolean                 @default(false)
  city                   String?
  documentsUploaded      Boolean                 @default(false)
  experience             String?
  facebook               String?
  gstNumber              String?
  gstVerified            Boolean                 @default(false)
  instagram              String?
  isActive               Boolean                 @default(true)
  linkedin               String?
  website                String?
  youtube                String?
  badge                  VendorBadge             @default(BRONZE)
  badgeBillingCycle      VendorBadgeBillingCycle @default(MONTHLY)
  monthlyBookingLimit    Int                     @default(5)
  badgePurchasedAt       DateTime?
  badgeExpiresAt         DateTime?
  badgePaymentOrderId    String?
  badgePaymentId         String?
  badgePaymentRefundId   String?
  badgePaymentRefundedAt DateTime?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?            @relation(fields: [categoryId], references: [id])
  packages      Package[]
  gallery       VendorGallery[]
  bookings      Booking[]
  availability  VendorAvailability[]
  portfolio     Portfolio[]
  reviews       Review[]
  leads         Lead[]
  conversations Conversation[]
  wishlists     Wishlist[]

  @@index([categoryId])
  @@index([status])
  @@index([badgeExpiresAt])
}

model VendorGallery {
  id       String @id @default(uuid())
  imageUrl String

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model Category {
  id    String  @id @default(uuid())
  name  String  @unique
  image String?

  vendors   Vendor[]
  packages  Package[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Package {
  id          String   @id @default(uuid())
  title       String
  description String?
  image       String?
  price       Decimal  @db.Decimal(10, 2)
  vendorId    String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inclusions  String[]

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id])

  bookings Booking[]
  reviews  Review[]
  leads    Lead[]

  @@index([vendorId])
  @@index([categoryId])
}

enum BookingStatus {
  PENDING
  ADVANCE_PAID
  ACCEPTED
  EVENT_COMPLETED
  AWAITING_ADMIN_REVIEW
  PAYMENT_APPROVED
  PAYMENT_HELD
  CONFIRMED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  PARTIAL
  REFUNDED
}

enum PayoutStatus {
  HELD_FOR_ADMIN_REVIEW
  RELEASE_PROCESSING
  RELEASED
  SETTLED
  FAILED
  REFUNDED
}

enum AvailabilityStatus {
  BLOCKED
}

model VendorAvailability {
  id     String             @id @default(uuid())
  date   DateTime
  status AvailabilityStatus @default(BLOCKED)
  reason String?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, date])
  @@index([vendorId])
  @@index([date])
}

model Booking {
  id String @id @default(uuid())

  bookingNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // Event Details
  eventType String?
  eventDate DateTime
  eventTime String?

  venue String?
  city  String?

  guests Int @default(0)

  customerName  String?
  customerEmail String?
  customerPhone String?

  brideName String?
  groomName String?

  eventTitle        String?
  primaryPersonName String?
  primaryPersonAge  Int?
  eventTheme        String?

  partnerName       String?
  partnerEmail      String?
  partnerPhone      String?
  partnerOccupation String?

  contactAddress String?
  contactState   String?
  contactCountry String?
  weddingTheme   String?

  notes               String?
  specialRequirements String?

  // Pricing
  totalAmount Decimal @db.Decimal(10, 2)

  paymentStatus PaymentStatus @default(PENDING)

  amountPaid Decimal @default(0) @db.Decimal(10, 2)

  remainingAmount Decimal @default(0) @db.Decimal(10, 2)

  advancePaymentOrderId String?
  finalPaymentOrderId   String?
  lastPaymentAt         DateTime?
  adminApproved         Boolean   @default(false)
  adminApprovedAt       DateTime?

  status BookingStatus @default(PENDING)

  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?
  payout BookingPayout?

  @@index([userId])
  @@index([vendorId])
  @@index([packageId])
  @@index([status])
}

model BookingPayout {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  grossAdvance       Decimal @db.Decimal(10, 2)
  platformCommission Decimal @db.Decimal(10, 2)
  vendorNetAmount    Decimal @db.Decimal(10, 2)

  commissionPolicy    String @default("ADVANCE_MARGINAL_V1")
  commissionBreakdown Json

  status    PayoutStatus @default(HELD_FOR_ADMIN_REVIEW)
  simulated Boolean      @default(true)

  razorpayPaymentId     String?
  razorpayTransferId    String? @unique
  transferFailureReason String?

  releasedAt           DateTime?
  settledAt            DateTime?
  vendorAcknowledgedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

