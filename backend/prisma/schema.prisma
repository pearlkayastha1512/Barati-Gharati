generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(USER)
  phone      String?  @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor              Vendor?
  bookings            Booking[]
  reviews             Review[]
  budget              Budget[]
  timelines           Timeline[]
  checklists          Checklist[]
  notifications       Notification[]
  guests              Guest[]
  chatMessages        ChatMessage[]
  leads               Lead[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]

  warningCount        Int       @default(0)
  chatMutedUntil      DateTime?
  isChatFlagged       Boolean   @default(false)
  isChatBlocked       Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  chatLastViolationAt DateTime?
  chatViolationReason String?

  sentMessages Message[] @relation("SentMessages")

  receivedMessages Message[] @relation("ReceivedMessages")

  customerConversations Conversation[] @relation("CustomerConversations")

  wishlists Wishlist[]
}

model Portfolio {
  id String @id @default(uuid())

  title       String
  category    String
  categories  String[] @default([])
  description String?

  imageUrl String

  vendorId      String
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id                     String       @id @default(uuid())
  businessName           String
  description            String?
  address                String?
  userId                 String       @unique
  categoryId             String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  coverImage             String?
  logoUrl                String?
  status                 VendorStatus @default(PENDING)
  approvedAt             DateTime?
  rejectionReason        String?
  frontendVendorId       Int?         @unique
  bankVerified           Boolean      @default(false)
  businessVerified       Boolean      @default(false)
  city                   String?
  documentsUploaded      Boolean      @default(false)
  experience             String?
  facebook               String?
  gstNumber              String?
  gstVerified            Boolean      @default(false)
  instagram              String?
  isActive               Boolean      @default(true)
  linkedin               String?
  website                String?
  youtube                String?
  badge                  VendorBadge  @default(BRONZE)
  monthlyBookingLimit    Int          @default(5)
  badgePurchasedAt       DateTime?
  badgePaymentOrderId    String?
  badgePaymentId         String?
  badgePaymentRefundId   String?
  badgePaymentRefundedAt DateTime?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?            @relation(fields: [categoryId], references: [id])
  packages      Package[]
  gallery       VendorGallery[]
  bookings      Booking[]
  availability  VendorAvailability[]
  portfolio     Portfolio[]
  reviews       Review[]
  leads         Lead[]
  conversations Conversation[]
  wishlists     Wishlist[]

  @@index([categoryId])
  @@index([status])
}

model VendorGallery {
  id        String   @id @default(uuid())
  imageUrl  String
  vendorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  packages  Package[]
  vendors   Vendor[]
}

model Package {
  id          String    @id @default(uuid())
  title       String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  vendorId    String
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inclusions  String[]
  bookings    Booking[]
  leads       Lead[]
  category    Category  @relation(fields: [categoryId], references: [id])
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviews     Review[]

  @@index([vendorId])
  @@index([categoryId])
}

model VendorAvailability {
  id        String             @id @default(uuid())
  date      DateTime
  status    AvailabilityStatus @default(BLOCKED)
  reason    String?
  vendorId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId])
  @@index([date])
}

model Booking {
  id                    String        @id @default(uuid())
  userId                String
  packageId             String
  eventDate             DateTime
  status                BookingStatus @default(PENDING)
  totalAmount           Decimal       @db.Decimal(10, 2)
  paymentStatus         PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  cancellationReason    String?
  notes                 String?
  vendorId              String
  remainingAmount       Decimal       @default(0) @db.Decimal(10, 2)
  bookingNumber         String        @unique
  brideName             String?
  city                  String?
  eventTime             String?
  eventType             String?
  groomName             String?
  guests                Int           @default(0)
  specialRequirements   String?
  venue                 String?
  amountPaid            Decimal       @default(0) @db.Decimal(10, 2)
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  partnerName           String?
  partnerEmail          String?
  partnerPhone          String?
  partnerOccupation     String?
  contactAddress        String?
  contactState          String?
  contactCountry        String?
  weddingTheme          String?
  eventTitle            String?
  primaryPersonName     String?
  primaryPersonAge      Int?
  eventTheme            String?
  advancePaymentOrderId String?
  adminApproved         Boolean       @default(false)
  adminApprovedAt       DateTime?
  finalPaymentOrderId   String?
  package               Package       @relation(fields: [packageId], references: [id])
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor                Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  review                Review?

  @@index([userId])
  @@index([vendorId])
  @@index([packageId])
  @@index([status])
}

model Review {
  id          String   @id @default(uuid())
  rating      Int      @default(5)
  comment     String?
  userId      String
  packageId   String
  createdAt   DateTime @default(now())
  bookingId   String   @unique
  updatedAt   DateTime @updatedAt
  vendorId    String
  vendorReply String?
  complaint   String?
  proofImages String[] @default([])
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package     Package  @relation(fields: [packageId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([userId])
  @@index([packageId])
}

model Guest {
  id        String      @id @default(uuid())
  name      String
  phone     String?
  email     String?
  status    GuestStatus @default(INVITED)
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Budget {
  id          String    @id @default(uuid())
  userId      String    @unique
  totalBudget Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses    Expense[]
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  date      DateTime @default(now())
  budgetId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Timeline {
  id          String           @id @default(uuid())
  userId      String
  title       String
  date        DateTime
  description String?
  status      TimelineStatus   @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  priority    TimelinePriority @default(MEDIUM)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Checklist {
  id        String   @id @default(uuid())
  task      String
  isDone    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String?
  eventDate   DateTime
  guestCount  Int
  message     String
  status      LeadStatus @default(PENDING)
  vendorReply String?
  userId      String
  vendorId    String
  packageId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  package     Package?   @relation(fields: [packageId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor      Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([userId])
  @@index([status])
}

model SiteContent {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Conversation {
  id          String     @id @default(uuid())
  customerId  String
  vendorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  portfolioId String?
  customer    User       @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id])
  vendor      Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([customerId])
  @@index([vendorId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  receiverId     String
  message        String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receiver       User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  message   String
  status    String   @default("sent")
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

model PlatformSettings {
  id                        String   @id @default("platform")
  allowVendorRegistration   Boolean  @default(true)
  allowCustomerRegistration Boolean  @default(true)
  enableReviews             Boolean  @default(true)
  enablePayments            Boolean  @default(true)
  maintenanceMode           Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorBadge {
  BRONZE
  SILVER
  GOLD
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ACCEPTED
  REJECTED
  ADVANCE_PAID
  EVENT_COMPLETED
  AWAITING_ADMIN_REVIEW
  PAYMENT_APPROVED
  PAYMENT_HELD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  PARTIAL
  REFUNDED
}

enum AvailabilityStatus {
  BLOCKED
}

enum GuestStatus {
  INVITED
  CONFIRMED
  DECLINED
}

enum TimelineStatus {
  PENDING
  COMPLETED
}

enum TimelinePriority {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
}

enum LeadStatus {
  PENDING
  RESPONDED
  CONVERTED
  CLOSED
}
